@baseUrl = http://localhost:5500


# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "ivan@mail.ru",
    "password": "password123"
}

# @name createSite
POST {{baseUrl}}/mongo-sites
Authorization: Bearer {{login.response.body.token}}
X-CSRF-Token: {{login.response.body.csrfToken}}
Content-Type: application/json

{
  "name": "Mongo GitHub",
  "domain": "github.com"
}


# @name createVisit
POST {{baseUrl}}/mongo-sites/{{createSite.response.body._id}}/visits
Authorization: Bearer {{login.response.body.token}}
X-CSRF-Token: {{login.response.body.csrfToken}}
Content-Type: application/json

{
  "visitorId": "mongo-user-1",
  "pageUrl": "/home",
  "referrer": "google.com"
}


POST {{baseUrl}}/mongo-sites/{{createSite.response.body._id}}/visits/{{createVisit.response.body.visits[0]._id}}/events
Authorization: Bearer {{login.response.body.token}}
X-CSRF-Token: {{login.response.body.csrfToken}}
Content-Type: application/json

{
  "eventName": "click",
  "pageUrl": "/pricing",
  "element": "buy-btn"
}

GET {{baseUrl}}/mongo-sites
Authorization: Bearer {{login.response.body.token}}